{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "console.anthropic.com",
        "claude.ai",
        "statsig.anthropic.com",
        "statsig.com",
        "sentry.io",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "astral.sh",
        "github.com",
        "*.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com"
      ],
      "strictAllowlist": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "**/.env",
        "**/.env.*"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "/usr/local/bin",
        "/usr/local/etc",
        "/etc"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ]
    }
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo:*)",
      "Bash(iptables:*)",
      "Bash(ip6tables:*)",
      "Bash(ipset:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  }
}
