{
  "name": "Claude Code Sandboxed Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE_IMAGE": "mcr.microsoft.com/devcontainers/base:debian-12",
      "WITH_MERMAID": "true",
      "WITH_PLANTUML": "false"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "containerEnv": {
    "PYTHONIOENCODING": "utf-8",
    "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium",
    "HISTFILE": "/commandhistory/.bash_history"
  },
  "mounts": [
    "source=claude-code-home-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=claude-code-history-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-vscode.powershell"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
