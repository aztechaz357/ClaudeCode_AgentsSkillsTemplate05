{
  "permissions": {
    "allow": [
      "Skill(agile-process)",
      "Skill(walking-skeleton)",
      "Skill(slice-definition)",
      "Skill(refactoring)",
      "Skill(layered-architecture)",
      "Skill(concept-definition)",
      "Skill(requirements-definition)",
      "Skill(functional-design)",
      "Skill(architecture-design)",
      "Skill(repository-structure)",
      "Skill(development-guidelines)",
      "Skill(glossary-creation)",
      "Skill(steering)",
      "Skill(tool-authoring)",
      "Skill(writing-conventions)",
      "Skill(workshop)",
      "Skill(quick-tool)",
      "Skill(note-taking)",
      "Skill(issue-tracking)",
      "Skill(catchup)",
      "Skill(option-first)",
      "Skill(test-design)",
      "Skill(architecture-drift)",
      "Skill(design-journal)",
      "Skill(drawio)",
      "Bash(git rev-list:*)",
      "PowerShell(git rev-list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "PowerShell(gh auth status:*)",
      "PowerShell(gh repo view:*)",
      "PowerShell(gh issue list:*)",
      "PowerShell(gh issue view:*)",
      "PowerShell(gh label list:*)",
      "Bash(glab auth status:*)",
      "Bash(glab repo view:*)",
      "Bash(glab issue list:*)",
      "Bash(glab issue view:*)",
      "Bash(glab label list:*)",
      "PowerShell(glab auth status:*)",
      "PowerShell(glab repo view:*)",
      "PowerShell(glab issue list:*)",
      "PowerShell(glab issue view:*)",
      "PowerShell(glab label list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(powershell -File .claude/tools/check_numbering.ps1:*)",
      "Bash(powershell -File .claude/tools/check_diagrams.ps1:*)",
      "Bash(powershell -File .claude/tools/check_mermaid.ps1:*)",
      "Bash(powershell -File .claude/tools/new_tool.ps1:*)",
      "Bash(powershell -File .claude/tools/new_note.ps1:*)",
      "Bash(powershell -File .claude/tools/index_workshop.ps1:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(& .\\.claude\\tools\\check_numbering.ps1:*)",
      "PowerShell(& .\\.claude\\tools\\check_diagrams.ps1:*)",
      "PowerShell(& .\\.claude\\tools\\check_mermaid.ps1:*)",
      "PowerShell(& .\\.claude\\tools\\new_tool.ps1:*)",
      "PowerShell(& .\\.claude\\tools\\new_note.ps1:*)",
      "PowerShell(& .\\.claude\\tools\\index_workshop.ps1:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/session-start-context.ps1",
            "timeout": 20,
            "statusMessage": "作業ツリーの状態を読み込み中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/pre-tool-guard.ps1",
            "timeout": 20,
            "statusMessage": "保護対象・破壊的操作を検査中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/post-edit-markdown.ps1",
            "timeout": 90,
            "statusMessage": "Markdown の番号を検証中"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/post-edit-python.ps1",
            "timeout": 60,
            "statusMessage": "Python の識別子を検証中"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/notify.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/stop-uncommitted.ps1",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
