# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 作業ノート（steering スキルが書く。共有しない）
.steering/

# 要求一覧（build_usdm.py の生成物。要求の正は docs/usdm/src/ の手書き HTML）
docs/usdm/index.html

# 現在地の 1 画面（build_status.py の生成物。/status で作り直す）
docs/status.html

# テストが残す証拠（visual-debugging スキル。再現用であって共有物ではない）
logs/test-artifacts/

# Claude Code の個人設定（許可リストは環境ごとに違う）
.claude/settings.local.json

# draw.io の書き出し（生成物。正は .drawio の方）
# 成果物として配る画像だけ `git add -f <file>` で明示的に追跡する
*.drawio.png
*.drawio.svg
*.drawio.pdf
*.drawio.bkp

ignore/